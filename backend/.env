# Servidor
PORT=3456
NODE_ENV=development

# Socket.IO
SOCKET_IO_CORS_ORIGIN=http://localhost:5173

# Claude Code SDK
CLAUDE_SDK_ENABLED=true
# DEFAULT_MODEL=claude-opus-4-6

# Workspace padrão do task runner
PICOCLAW_WORKSPACE=/Users/2a/.claude/batalha/picoclaw-mythos/backend

# Workspace do picoclaw Go (ativa análise cruzada)
PICOCLAW_GOPATH=/Users/2a/.claude/batalha/picoclaw-mythos

# Logs do picoclaw
PICOCLAW_LOGS=/Users/2a/.picoclaw/logs

# Agentes e skills globais do Claude
CLAUDE_AGENTS_PATH=/Users/2a/.claude/agents
CLAUDE_SKILLS_PATH=/Users/2a/.claude/skills

# Modo autônomo — ciclo de auto-revisão (minutos)
AUTONOMOUS_INTERVAL_MIN=30

